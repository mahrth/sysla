{
    "name": "sysla-workspace",
    "description": "Base workspace package",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "engines": {
        "node": "^22.12.0 || >=24.0.0",
        "npm": ">=10.2.3"
    },
    "scripts": {
        "clean": "npm run clean --workspaces",
        "watch": "tsc -b tsconfig.build.json --watch",
        "build": "tsc -b tsconfig.build.json && npm run build --workspaces",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "npm run --workspace packages/language langium:generate",
        "langium:watch": "npm run --workspace packages/language langium:watch",
        "test": "npm run build && npm run test --workspaces --if-present",
        "gen": "node packages/cli/bin/cli.js generate"
    },
    "devDependencies": {
        "@types/node": "^22.12.0",
        "typescript": "~5.8.3"
    },
    "volta": {
        "node": "24.18.0",
        "npm": "11.16.0"
    },
    "workspaces": [
        "packages/language",
        "packages/cli",
        "packages/extension"
    ],
    "allowScripts": {
        "esbuild@0.25.12": true
    }
}
